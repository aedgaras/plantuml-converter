@startuml
title PlantUML -> OpenAPI transformacijos procesas

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam dpi 140
skinparam ArrowColor #334155
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  DiamondBackgroundColor #E2E8F0
  DiamondBorderColor #334155
  StartColor #0F766E
  EndColor #0F766E
  BarColor #334155
  FontColor #0F172A
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #C2410C
  FontColor #431407
}

start

:PlantUML diagrama;
:Parse į tarpinį UML modelį;

:Normalizuoti modelį;
note right
  Vardai, enum reikšmės,
  ryšiai ir kardinalumai.
end note

:Sukaupti diagnostikas;
:Atskirti domeno ir API elementus;

:Sudaryti komponentų schemas;
note right
  Klasės ir sąsajos -> object schemas,
  enum -> string enum,
  metodai -> x-methods.
end note

:Pritaikyti UML ryšius;
note right
  Paveldimumas -> allOf,
  asociacijos -> $ref arba array.
end note

:Pridėti pagalbines schemas;

if (Yra <<Path>> elementų?) then (taip)
  :Kurti explicit API kelius;
  :Prijungti parameters, requestBody ir responses;
else (ne)
  :Generuoti numatytus CRUD kelius;
  :Metodus paversti action endpointais;
endif

:Surinkti OpenAPI 3.1 dokumentą;
:Validuoti dokumentą;
note right
  Tikrinami $ref, path parameter,
  response/request pilnumas
  ir paveldimumo ciklai.
end note

:Kanonizuoti rezultatą;

if (Strict režimas ir yra klaidų?) then (taip)
  :Grąžinti klaidų sąrašą;
  stop
else (ne)
  :Grąžinti OpenAPI dokumentą
  ir diagnostikas;
endif

stop
@enduml
